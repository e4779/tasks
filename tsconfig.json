{
  "compilerOptions": {
    "skipLibCheck": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "types": ["bun-types"],
    "target": "esnext"
  },
  "include": ["src", "bin", "test"]
}
