{
  "name": "tsk",
  "type": "module",
  "bin": {
    "tsk": "dist/tsk.js"
  },
  "files": [
    "dist",
    "web",
    "skills",
    "README.md",
    "package.json"
  ],
  "pi": {
    "skills": [
      "./skills/tsk-workflow"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "check:full": "biome check . && tsc --noEmit",
    "test": "bun test",
    "build": "bun build ./bin/tsk.ts --outfile dist/tsk.js --target=node --external elkjs",
    "prepare": "bun run build"
  },
  "dependencies": {
    "d3": "7",
    "elkjs": "^0.12.1",
    "gray-matter": "^4.0.3",
    "markdown-it": "^15.0.3",
    "open-props": "^1.7.23",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
